# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev*.log
*.out.log
*.err.log

# env files (never commit any .env variant)
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development
.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ————————————————————————————————————————
# nxtdev specific additions below
# ————————————————————————————————————————

# secrets & keys (extra safety net)
*.key
*.p12
*.pfx
*.crt
*.cer
secrets.json
secrets.*.json

# wrangler (Cloudflare Workers)
.wrangler/
wrangler.toml.local

# supabase local
supabase/.branches
supabase/.temp

# powerdns
*.zone.bak
pdns.conf
pdns.local.conf

# editor & OS
.idea/
.vscode/settings.json
*.swp
*.swo
*~

# temp & cache
.cache/
.temp/
tmp/

# pm2 (if you ever run locally)
ecosystem.config.local.js
.pm2/
